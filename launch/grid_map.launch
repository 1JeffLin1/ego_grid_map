<launch>
    <!-- This package is named plan_env in the fork. -->
    <arg name="cloud_topic" default="/cloud_registered"/>
    <arg name="odom_topic" default="/Odometry"/>
    <!-- Set to the actual frame_id of both FAST-LIO2 topics, e.g. camera_init. -->
    <arg name="map_frame" default="world"/>

    <arg name="resolution" default="0.15"/>
    <arg name="map_size_x" default="8.0"/>
    <arg name="map_size_y" default="6.0"/>
    <arg name="map_size_z" default="3.0"/>
    <arg name="rolling_z" default="false"/>
    <arg name="obstacle_ttl" default="1.0"/>
    <arg name="obstacles_inflation" default="0.299"/>
    <arg name="rviz" default="false"/>

    <node pkg="plan_env" type="gridmap_node" name="gridmap_node" output="screen">
        <remap from="/grid_map/cloud" to="$(arg cloud_topic)"/>
        <remap from="/grid_map/odom" to="$(arg odom_topic)"/>

        <param name="grid_map/use_cloud_input" value="true"/>
        <param name="grid_map/rolling_z" value="$(arg rolling_z)"/>
        <param name="grid_map/obstacle_ttl" value="$(arg obstacle_ttl)"/>
        <param name="grid_map/resolution" value="$(arg resolution)"/>
        <param name="grid_map/map_size_x" value="$(arg map_size_x)"/>
        <param name="grid_map/map_size_y" value="$(arg map_size_y)"/>
        <param name="grid_map/map_size_z" value="$(arg map_size_z)"/>
        <!-- Must fit inside map half-extents; allow some space for inflation. -->
        <param name="grid_map/local_update_range_x" value="3.5"/>
        <param name="grid_map/local_update_range_y" value="2.5"/>
        <param name="grid_map/local_update_range_z" value="1.0"/>
        <param name="grid_map/obstacles_inflation" value="$(arg obstacles_inflation)"/>
        <param name="grid_map/ground_height" value="-0.01"/>
        <param name="grid_map/local_map_margin" value="0"/>
        <param name="grid_map/skip_pixel" value="2"/>
        <param name="grid_map/pose_type" value="2"/>
        <param name="grid_map/frame_id" value="$(arg map_frame)"/>
        <param name="grid_map/visualization_truncate_height" value="1000000.0"/>
    </node>

    <group if="$(arg rviz)">
        <node pkg="rviz" type="rviz" name="rviz"
              args="-d $(find plan_env)/launch/plan_env.rviz" output="screen"/>
    </group>
</launch>
